# Copy to .env next to compose.yaml and fill in. Keep .env private: it may
# hold a Tailscale auth key.

# The image built from this repository (Dockerfile).
HOMECLOUD_IMAGE=homecloud:latest

# The NAS user that owns the folders below (id -u / id -g).
PUID=1000
PGID=1000

# Your time zone (IANA name), for times homecloud prints.
TZ=Europe/Athens

# The archive (storage.root inside the container is /archive).
HOMECLOUD_ARCHIVE=/volume1/homecloud/archive
# config/ (config.toml), state/ (iCloud sessions, kei's catalog: private) and
# tailscale/ (the node's identity).
HOMECLOUD_DATA=/volume1/homecloud/data
# Ledger snapshots: a folder on another drive than the archive.
HOMECLOUD_BACKUPS=/volume2/homecloud-backups
# The iPhone backups to monitor (a read-only mount of the PC's share).
HOMECLOUD_IPHONE_BACKUPS=/mnt/pc-iphone-backups

# The drives holding the archive, for drive health: their stable names from
# `ls -l /dev/disk/by-id/` on the NAS (ata-… for SATA drives, nvme-… for
# NVMe), not sda/sdb, which can change between boots. For another number of
# drives, change the devices: list in compose.yaml; `docker compose exec
# homecloud homecloud doctor` names any drive it cannot read.
HOMECLOUD_DRIVE_1=/dev/disk/by-id/ata-ST4000VN006-3CW104_ZW600001
HOMECLOUD_DRIVE_2=/dev/disk/by-id/ata-ST4000VN006-3CW104_ZW600002

# The node's name on your tailnet: the app is at https://<this>.<tailnet>.ts.net.
# Tailscale appends -1, -2… when the name is taken: set web.public_origin to
# the name `docker compose exec tailscale tailscale status` shows.
TS_HOSTNAME=homecloud
# A Tailscale auth key, for the first start only (admin console, Keys).
TS_AUTHKEY=
