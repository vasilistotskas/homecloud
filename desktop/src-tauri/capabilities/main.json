{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: core window APIs, the app's own commands, and writing to the app's log (tauri-plugin-log's log command only).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-connection-settings",
    "allow-connection-credentials",
    "allow-connect-remote",
    "allow-use-this-pc",
    "allow-device-name",
    "allow-start-agent",
    "allow-reveal-in-folder",
    "log:allow-log"
  ]
}
